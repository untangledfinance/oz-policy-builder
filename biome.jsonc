{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}",
      "!**/dist",
      "!**/dist-cjs",
      "!**/.wrangler",
      "!**/coverage",
      "!**/*.tsbuildinfo",
      "!**/worker-configuration.d.ts",
      "!**/test_snapshots",
      // Written by the interpreter's tests/parity.rs: compact on purpose, one case a line.
      "!packages/policy-synth/fixtures/parity",
      // Recorded JSON-RPC responses (OPB_LIVE=1 rewrites them).
      "!packages/policy-synth/fixtures/rpc",
      // Written by contracts/near/vectors/generator (one-space indent, as JSON.stringify
      // writes it). Regenerating must give the same bytes, so the formatter keeps out.
      "!contracts/near/vectors/requests.json",
      "!agents"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/scripts/**", "**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
