@@ -0,0 +1,67 @@
+//! Wallet signature schema for Stellar wallets (Freighter, LOBSTR, ...):
+//! the owner signs a readable text with SEP-53 `signMessage`, i.e.
+//! `ed25519(sha256("Stellar Signed Message:\n" || text))`.
+//!
+//! The text is built by the contract itself from the request, so the
+//! wallet shows exactly what will run and the signature covers all of it.
+#[cfg(feature = "contract")]
+mod contract;
+#[cfg(feature = "signer")]
+mod signer;
+#[cfg(feature = "signer")]
+pub use self::signer::*;
+
+use core::str::FromStr;
+
+pub use defuse_crypto as crypto;
+use defuse_crypto::{
+    Curve,
+    ed25519::{Ed25519, Ed25519PublicKey, Ed25519Signature},
+};
+use defuse_sep53::Sep53;
+use defuse_wallet::{RequestMessage, SignatureSchema, offchain::OffchainMessage};
+
+pub struct WalletSep53;
+
+impl WalletSep53 {
+    /// Header of every signed request; separates it from other SEP-53 texts.
+    pub const REQUEST_HEADER: &str = "NEAR wallet request (NEAR_WALLET_CONTRACT/V1):\n";
+    /// Header of every signed NEP-641 offchain message.
+    pub const OFFCHAIN_HEADER: &str = "NEAR wallet offchain message (NEAR_WALLET_CONTRACT/V1):\n";
+
+    /// Text the Stellar wallet signs for a request.
+    pub fn request_text(msg: &RequestMessage) -> String {
+        let json = serde_json::to_string_pretty(msg).expect("json: failed to serialize");
+        [Self::REQUEST_HEADER, &json].concat()
+    }
+
+    /// Text the Stellar wallet signs for an offchain message.
+    pub fn offchain_text(msg: &OffchainMessage) -> String {
+        let json = serde_json::to_string_pretty(msg).expect("json: failed to serialize");
+        [Self::OFFCHAIN_HEADER, &json].concat()
+    }
+
+    fn verify_text(public_key: &Ed25519PublicKey, text: &str, proof: &str) -> bool {
+        let Ok(signature) = Ed25519Signature::from_str(proof) else {
+            return false;
+        };
+        let Ok(public_key) = <Ed25519 as Curve>::PublicKey::try_from(public_key) else {
+            return false;
+        };
+        Sep53::verify(&public_key, text, &signature.into())
+    }
+}
+
+impl SignatureSchema for WalletSep53 {
+    type PublicKey = Ed25519PublicKey;
+
+    #[inline]
+    fn verify_request_msg(public_key: &Self::PublicKey, msg: &RequestMessage, proof: &str) -> bool {
+        Self::verify_text(public_key, &Self::request_text(msg), proof)
+    }
+
+    #[inline]
+    fn verify_offchain_msg(public_key: &Self::PublicKey, msg: &OffchainMessage, proof: &str) -> bool {
+        Self::verify_text(public_key, &Self::offchain_text(msg), proof)
+    }
+}
