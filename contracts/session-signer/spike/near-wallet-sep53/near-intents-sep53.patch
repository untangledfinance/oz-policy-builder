+use defuse_crypto::{
+    Signer,
+    ed25519::{Ed25519, Ed25519PublicKey, Ed25519Signature},
+};
+use defuse_sep53::Sep53;
+use defuse_wallet::offchain::OffchainMessage;
+use defuse_wallet_sdk::{Proof, RequestMessage, WalletSigner};
+
+use crate::WalletSep53;
+
+/// Signs like a Stellar wallet's SEP-53 `signMessage`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct WalletSep53Signer<S>(pub S);
+
+impl<S: Signer<Ed25519>> WalletSep53Signer<S> {
+    async fn sign_text(&self, text: &str) -> Result<Proof, S::Error> {
+        let sig = self.0.sign(&Sep53::prehash(text)).await?;
+        Ok(Ed25519Signature::from(sig).to_string())
+    }
+}
+
+impl<S: Signer<Ed25519>> WalletSigner<WalletSep53> for WalletSep53Signer<S> {
+    type Error = S::Error;
+
+    #[inline]
+    fn public_key(&self) -> Ed25519PublicKey {
+        self.0.public_key().into()
+    }
+
+    async fn sign_request_msg(&self, msg: &RequestMessage) -> Result<Proof, Self::Error> {
+        self.sign_text(&WalletSep53::request_text(msg)).await
+    }
+
+    async fn sign_offchain_msg(&self, msg: &OffchainMessage) -> Result<Proof, Self::Error> {
+        self.sign_text(&WalletSep53::offchain_text(msg)).await
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use defuse_crypto::ed25519::ed25519_dalek;
+    use defuse_wallet::{DEFAULT_TIMEOUT, Request, SignatureSchema, Timestamp};
+    use defuse_wallet_sdk::MAINNET;
+    use rand::{rand_core::UnwrapErr, rngs::SysRng};
+
+    use super::*;
+
+    fn key() -> WalletSep53Signer<ed25519_dalek::SigningKey> {
+        WalletSep53Signer(ed25519_dalek::SigningKey::generate(&mut UnwrapErr(SysRng)))
+    }
+
+    fn msg(nonce: u32) -> RequestMessage {
+        RequestMessage {
+            pay_for_gas: false,
+            chain_id: MAINNET.to_string(),
+            signer_id: "signer.near".parse().unwrap(),
+            nonce,
+            created_at: Timestamp::now(),
+            timeout: DEFAULT_TIMEOUT,
+            request: Request::new(),
+        }
+    }
+
+    #[tokio::test]
+    async fn sign_verify() {
+        let (a, b, m) = (key(), key(), msg(7));
+        let pk = WalletSigner::<WalletSep53>::public_key(&a);
+        let proof = a.sign_request_msg(&m).await.unwrap();
+        assert!(WalletSep53::verify_request_msg(&pk, &m, &proof));
+        // another request, another key, or a plain-hash signature all fail
+        assert!(!WalletSep53::verify_request_msg(&pk, &msg(8), &proof));
+        let other = b.sign_request_msg(&m).await.unwrap();
+        assert!(!WalletSep53::verify_request_msg(&pk, &m, &other));
+        let raw = Ed25519Signature::from(a.0.sign(&m.hash()).await.unwrap()).to_string();
+        assert!(!WalletSep53::verify_request_msg(&pk, &m, &raw));
+        assert!(!WalletSep53::verify_request_msg(&pk, &m, "garbage"));
+    }
+
+    #[test]
+    fn text_is_readable() {
+        let t = WalletSep53::request_text(&msg(1));
+        assert!(t.starts_with(WalletSep53::REQUEST_HEADER));
+        assert!(t.contains("\"signer_id\": \"signer.near\""));
+        println!("{t}");
+    }
+}
+
