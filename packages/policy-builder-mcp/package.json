{
  "name": "@crediolabs/policy-builder-mcp",
  "version": "0.3.1",
  "license": "MIT",
  "description": "MCP server exposing the OZ policy-synth core (record_transaction + synthesize_policy) over stdio and Streamable HTTP transports.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/untangledfinance/oz-policy-builder.git",
    "directory": "packages/policy-builder-mcp"
  },
  "homepage": "https://github.com/untangledfinance/oz-policy-builder#readme",
  "bugs": {
    "url": "https://github.com/untangledfinance/oz-policy-builder/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "openzeppelin",
    "policy",
    "smart-account",
    "authorization"
  ],
  "sideEffects": false,
  "author": {
    "name": "Untangled Finance Limited",
    "url": "https://untangled.finance"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist-cjs/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "policy-builder-mcp": "dist/bin/server.js"
  },
  "files": [
    "dist",
    "dist-cjs",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "rm -rf dist dist-cjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.cjs",
    "prepublishOnly": "bun run build && bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@crediolabs/policy-synth": "0.3.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stellar/stellar-sdk": "14.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.1.1",
    "typescript": "5.9.3"
  }
}
