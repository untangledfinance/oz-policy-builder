        {
          "name": "synthesize_policy, from an intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 5,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"synthesize_policy\",\n    \"arguments\": {\n      \"network\": \"{{network}}\",\n      \"intent\": {\n        \"calls\": [\n          {\n            \"contract\": \"{{token}}\",\n            \"fn\": \"transfer\",\n            \"where\": [\n              {\n                \"constraint\": \"allow\",\n                \"at\": [\n                  1\n                ],\n                \"in\": [\n                  \"{{recipient}}\"\n                ]\n              },\n              {\n                \"constraint\": \"cap\",\n                \"at\": [\n                  2\n                ],\n                \"max\": \"{{capAmount}}\"\n              }\n            ]\n          }\n        ]\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
