    {
      "name": "Build an unsigned transaction",
      "description": "Each tool returns an unsigned transaction for a wallet to sign. Nothing is signed or sent. Run install_policy before review_unsigned: it stores the transaction in the unsignedXdr variable.",
      "item": [
        {
          "name": "install_policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 10,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"install_policy\",\n    \"arguments\": {\n      \"network\": \"{{network}}\",\n      \"intent\": {\n        \"calls\": [\n          {\n            \"contract\": \"{{token}}\",\n            \"fn\": \"transfer\",\n            \"where\": [\n              {\n                \"constraint\": \"allow\",\n                \"at\": [\n                  1\n                ],\n                \"in\": [\n                  \"{{recipient}}\"\n                ]\n              },\n              {\n                \"constraint\": \"cap\",\n                \"at\": [\n                  2\n                ],\n                \"max\": \"{{capAmount}}\"\n              }\n            ]\n          }\n        ]\n      },\n      \"smartAccount\": \"{{smartAccount}}\",\n      \"sourceAccount\": \"{{sourceAccount}}\",\n      \"signers\": [\n        \"{{agentSigner}}\"\n      ],\n      \"name\": \"transfer-cap\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["mcp"]
            },
            "description": "Builds add_context_rule for the account. sourceAccount must be a signer of the account's rule 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the unsigned transaction is kept for review_unsigned', () => {",
                  "  const r = JSON.parse(pm.response.text().split('\\n').find((l) => l.startsWith('data: ')).slice(6));",
                  "  pm.expect(r.result.structuredContent.unsignedXdr).to.be.a('string');",
                  "  pm.collectionVariables.set('unsignedXdr', r.result.structuredContent.unsignedXdr);",
                  "});"
                ]
              }
            }
          ]
        },
