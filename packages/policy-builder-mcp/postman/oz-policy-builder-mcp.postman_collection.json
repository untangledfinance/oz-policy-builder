  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every response is a Server-Sent Events stream with one `data:` line holding the JSON-RPC reply.",
          "const line = pm.response.text().split('\\n').find((l) => l.startsWith('data: '));",
          "const msg = line ? JSON.parse(line.slice(6)) : undefined;",
          "pm.test('HTTP 200 with a JSON-RPC reply', () => {",
          "  pm.response.to.have.status(200);",
          "  pm.expect(msg, 'a data: line').to.be.an('object');",
          "  pm.expect(msg.error, 'no JSON-RPC error').to.equal(undefined);",
          "});",
          "// A tool refusal is a normal reply with isError true; a request is named \"(refusal)\" when it expects one.",
          "if (msg && msg.result && typeof msg.result.isError === 'boolean') {",
          "  const refusal = pm.info.requestName.includes('(refusal)');",
          "  pm.test(refusal ? 'the tool refuses' : 'the tool answers', () => {",
          "    pm.expect(msg.result.isError).to.equal(refusal);",
          "  });",
          "}"
        ]
      }
    }
  ],
