              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["mcp"]
            },
            "description": "The call must pass, each constraint turned against it must refuse it, and each conjunct dropped in turn must let a call through. Read `complete` as well as `ok`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const out = JSON.parse(pm.response.text().split('\\n').find((l) => l.startsWith('data: ')).slice(6)).result.structuredContent;",
                  "pm.test(\"ok and complete\", () => pm.expect(out.ok && out.complete).to.equal(true));"
                ]
              }
            }
          ]
        }
      ]
