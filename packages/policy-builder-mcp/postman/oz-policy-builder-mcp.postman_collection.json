        {
          "name": "simulate_policy, a permitted call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 7,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"simulate_policy\",\n    \"arguments\": {\n      \"network\": \"{{network}}\",\n      \"intent\": {\n        \"calls\": [\n          {\n            \"contract\": \"{{token}}\",\n            \"fn\": \"transfer\",\n            \"where\": [\n              {\n                \"constraint\": \"allow\",\n                \"at\": [\n                  1\n                ],\n                \"in\": [\n                  \"{{recipient}}\"\n                ]\n              },\n              {\n                \"constraint\": \"cap\",\n                \"at\": [\n                  2\n                ],\n                \"max\": \"{{capAmount}}\"\n              }\n            ]\n          }\n        ]\n      },\n      \"calls\": [\n        {\n          \"contract\": \"{{token}}\",\n          \"fn\": \"transfer\",\n          \"args\": [\n            \"{{smartAccount}}\",\n            \"{{recipient}}\",\n            {\n              \"i128\": \"5000000\"\n            }\n          ]\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["mcp"]
            },
            "description": "Asks the interpreter whether the rule permits each call. Expect permitted true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const out = JSON.parse(pm.response.text().split('\\n').find((l) => l.startsWith('data: ')).slice(6)).result.structuredContent;",
                  "pm.test(\"the call is permitted\", () => pm.expect(out.results[0].permitted).to.equal(true));"
                ]
              }
            }
          ]
        },
