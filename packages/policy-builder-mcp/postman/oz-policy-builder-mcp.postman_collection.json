              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["mcp"]
            },
            "description": "A transfer above the cap: the reply is a normal result with permitted false and a deny code."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const out = JSON.parse(pm.response.text().split('\\n').find((l) => l.startsWith('data: ')).slice(6)).result.structuredContent;",
                  "pm.test(\"the call is refused with a deny code\", () => pm.expect(out.results[0].permitted === false && out.results[0].code > 0).to.equal(true));"
                ]
              }
            }
          ]
        },
