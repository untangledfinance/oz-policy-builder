{
  "name": "@crediolabs/policy-synth",
  "version": "4.0.1",
  "license": "MIT",
  "description": "Off-chain TypeScript core for the OZ Accounts Policy Builder: record a Soroban transaction or state a mandate, get the rule that permits exactly that, verify it through the interpreter's own `check`, and return an unsigned install transaction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/untangledfinance/oz-policy-builder.git",
    "directory": "packages/policy-synth"
  },
  "homepage": "https://github.com/untangledfinance/oz-policy-builder#readme",
  "bugs": {
    "url": "https://github.com/untangledfinance/oz-policy-builder/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "openzeppelin",
    "policy",
    "smart-account",
    "authorization"
  ],
  "sideEffects": false,
  "author": {
    "name": "Untangled Finance Limited",
    "url": "https://untangled.finance"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./run": {
      "types": "./dist/tools.d.ts",
      "bun": "./src/tools.ts",
      "import": "./dist/tools.js",
      "require": "./dist-cjs/tools.js",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-cjs",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "rm -rf dist dist-cjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.cjs",
    "prepublishOnly": "bun run build && bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^14.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@stellar/stellar-sdk": "14.4.0",
    "@types/node": "^26.1.1",
    "typescript": "5.9.3"
  }
}
