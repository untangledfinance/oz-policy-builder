{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@crediolabs/policy-synth": ["../policy-synth/dist/index.d.ts"],
      "@crediolabs/policy-synth/run": ["../policy-synth/dist/run/index.d.ts"]
    },
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist-cjs",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
