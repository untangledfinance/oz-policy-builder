# Copy to scripts/.env, or just run:
#   bun scripts/demo-gates-testnet.ts setup
# which creates four funded testnet keys and writes them here for you.
#
# scripts/.env is covered by .gitignore. Never put a mainnet secret in it.
DEMO_CUSTODY_SECRET=S...   # holds the funds; weight 10 after setup
DEMO_COSIGN_SECRET=S...    # the second weight-10 signer
DEMO_AGENT_SECRET=S...     # proposes moves; policed by the rulebook
DEMO_ADMIN_SECRET=S...     # deploys, and holds Prime's rule 0
